# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Same width as rustfmt.toml.
[*.rs]
indent_size = 4
max_line_length = 120

[*.{py,swift,kt,kts,java,gradle}]
indent_size = 4

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false

# Xcode writes tabs.
[*.{pbxproj,plist,xcprivacy,entitlements}]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Benchmark output from external tools: kept byte-exact.
[bench/results/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Vendored upstream code keeps upstream's conventions (see THIRD_PARTY_NOTICES.md).
[vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
