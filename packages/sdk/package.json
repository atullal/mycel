{
  "name": "@mycel/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for Mycel apps: typed client over the Mycel runtime, plus React hooks.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./react/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "~5.9.3"
  }
}
