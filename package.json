{
  "name": "mycel",
  "version": "0.0.1",
  "private": true,
  "description": "Mycel: a fully decentralised, end-to-end encrypted peer-to-peer platform",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atullal/mycel.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev -w @mycel/host",
    "build": "npm run build -w @mycel/host",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "^2.6.0-alpha.3",
    "@automerge/automerge-repo-network-broadcastchannel": "^2.6.0-alpha.3",
    "@automerge/automerge-repo-network-messagechannel": "^2.6.0-alpha.3",
    "@automerge/automerge-repo-network-websocket": "^2.6.0-alpha.3"
  }
}
