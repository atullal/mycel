<?xml version="1.0" encoding="utf-8"?>
<!-- Mycel keeps nothing in Android backups or device-to-device transfers
     (Android 12+). The identity key is this device's alone: a copy on another
     phone would be a second device using the same key. Conversations are
     private and come back from peers once the new device is added. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
