{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mycel",
  "version": "0.1.0",
  "identifier": "dev.mycel.host",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mycel",
        "width": 1240,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "Peer-to-peer, end-to-end encrypted apps with no server",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.4",
      "developmentTeam": "G2RU5ZQR8P"
    },
    "android": {
      "minSdkVersion": 28
    }
  }
}
